{
  "expo": {
    "name": "Vendure Admin",
    "slug": "vendure-admin-app-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vendureadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.hyperce.vendureadmin"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131719",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.hyperce.vendureadmin"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131719",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "./plugins/with-android-ndk-version",
        {
          "ndkVersion": "28.2.13676358"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to upload as product and collection images.",
          "cameraPermission": "Take photos to upload as product images.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
